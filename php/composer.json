{
    "name": "tienphat/serpscraper-php",
    "description": "Official PHP client for SerpScraper.Dev — real-time Google & Bing search results API, AI Overviews, Google Trends, and Web Scraping.",
    "keywords": ["serp", "serp-api", "serpscraper", "google", "bing", "search-api", "web-scraping", "seo", "ai-overview", "google-trends"],
    "homepage": "https://serpscraper.dev",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "SerpScraper.Dev",
            "email": "support@serpscraper.dev",
            "homepage": "https://serpscraper.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SerpScraper\\": "src/"
        },
        "files": [
            "src/compatibility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SerpScraper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite=Unit",
        "test:integration": "vendor/bin/phpunit --testsuite=Integration"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
